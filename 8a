#!/bin/bash
#SBATCH --job-name=vcftools_filter
#SBATCH --output=/uufs/chpc.utah.edu/common/home/u1055819/saarman-group/cx_ddRAD_scripts/logs/8a_vcftools_filter_%j.out
#SBATCH --error=/uufs/chpc.utah.edu/common/home/u1055819/saarman-group/cx_ddRAD_scripts/logs/8a_vcftools_filter_%j.err
#SBATCH --time=02:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --account=saarman-np
#SBATCH --partition=saarman-np
#SBATCH --mail=emily.calhoun@usu.edu

module load vcftools

# --- Paths ---
IN_VCF="/uufs/chpc.utah.edu/common/home/u1055819/saarman-group/cx_ddRAD_populations_output/populations.snps.vcf"
OUTDIR="/uufs/chpc.utah.edu/common/home/u1055819/saarman-group/cx_ddRAD_filtered"
OUT_PREFIX="${OUTDIR}/ddrad_filtered"

mkdir -p ${OUTDIR}

# ============================================================
# FILTER RATIONALE
# --remove-indels       : SNPs only; indels unreliable in RADseq
# --min-alleles 2       : biallelic only
# --max-alleles 2       : biallelic only
# --max-missing 0.5     : genotype present in >=50% of individuals
#                         Replaces --geno 0.2 (80% completeness) which
#                         dropped 93% of SNPs. 50% is appropriate for
#                         RADseq where locus dropout is expected.
#                         Tighten to 0.6 if you want ~15k cleaner SNPs.
# --maf 0.05            : minor allele freq >=5%; removes singletons
# --minDP 5             : min mean depth per genotype call
# --minQ 30             : Phred Q30 = 99.9% base call accuracy
# --thin 500            : 1 SNP per 500bp; reduces LD within RAD loci
#                         (~150bp each). Remove if handling LD in R.
# ============================================================

echo "Starting vcftools filtering..."
echo "Input: ${IN_VCF}"
echo "$(date)"

vcftools \
    --vcf ${IN_VCF} \
    --remove-indels \
    --min-alleles 2 \
    --max-alleles 2 \
    --max-missing 0.5 \
    --maf 0.05 \
    --minDP 5 \
    --minQ 30 \
    --thin 500 \
    --recode \
    --recode-INFO-all \
    --out ${OUT_PREFIX}

mv ${OUT_PREFIX}.recode.vcf ${OUT_PREFIX}.vcf

echo ""
echo "=== FILTER SUMMARY ==="
NSNP=$(grep -v "^#" ${OUT_PREFIX}.vcf | wc -l)
NIND=$(grep "^#CHROM" ${OUT_PREFIX}.vcf | tr '\t' '\n' | tail -n +10 | wc -l)
echo "SNPs retained: ${NSNP}"
echo "Individuals:   ${NIND}"
echo "$(date)"
echo "======================"
echo "Next step: run 8b_bcftools_ABfilter.slurm"
